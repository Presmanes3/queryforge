# Use NVIDIA CUDA base for reliable 12.1 support.
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

# Prevent pip layer caching and set non-interactive for apt.
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV HF_HUB_OFFLINE=1

# Install Python and essential build tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Pin minimum dependencies with explicit CUDA index.
RUN pip install --upgrade pip && \
    pip install vllm==0.6.3 xformers==0.0.27.post2 --extra-index-url https://download.pytorch.org/whl/cu121 && \
    pip install "transformers==4.45.2" fastapi uvicorn boto3 peft

RUN mkdir -p /app/src/inference
COPY src/inference/app.py /app/app.py
COPY src/inference/_gpu.py /app/_gpu.py
COPY src/inference/_gpu.py /app/src/inference/_gpu.py
# Create empty __init__.py to allow relative imports
RUN touch /app/src/__init__.py /app/src/inference/__init__.py

WORKDIR /app

# Set PYTHONPATH to root /app so imports from src.* work correctly
ENV PYTHONPATH="/app"

# Expose port 8080 to comply with SageMaker container requirements.
EXPOSE 8080

# Create a 'serve' script that SageMaker will execute automatically.
RUN mkdir -p /usr/local/bin && \
    echo '#!/bin/bash\nexec uvicorn app:app --host 0.0.0.0 --port 8080' > /usr/local/bin/serve \
    && chmod +x /usr/local/bin/serve

CMD ["serve"]
